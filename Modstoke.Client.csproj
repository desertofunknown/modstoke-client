<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Modstoke.Client</AssemblyName>
    <Title>Modstoke Client</Title>
    <Product>Modstoke Client by OpenACAI</Product>
    <Company>OpenACAI</Company>
    <Description>Field tablet and wristwatch with navigation, messages and community services, by OpenACAI.</Description>
    <Version>0.2.4</Version>
    <RootNamespace>Modstoke.Client</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <PathMap>$(MSBuildProjectDirectory)=/_/Modstoke.Client</PathMap>
    <PathMap Condition="'$(ArtifactsPath)' != ''">$(PathMap),$(ArtifactsPath)=/_/artifacts</PathMap>
    <LoaderAssemblyPath Condition="'$(LoaderAssemblyPath)' == ''">$(MSBuildProjectDirectory)\..\Modstoke.Loader\bin\Release\Modstoke.Loader.dll</LoaderAssemblyPath>
    <GameRoot Condition="'$(GameRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\..</GameRoot>
    <GameInteropRoot Condition="'$(GameInteropRoot)' == ''">$(GameRoot)\BepInEx\interop</GameInteropRoot>
    <SonsSdkPath Condition="'$(SonsSdkPath)' == ''">$(GameRoot)\BepInEx\plugins\OpenACAILoader\SonsSdk.dll</SonsSdkPath>
  </PropertyGroup>
